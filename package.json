{
  "name": "portfolio-gabrielly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit",
    "verify": "npm run check && npm run test:e2e",
    "format": "prettier --write src tests scripts .github *.ts *.mjs *.json README.md",
    "format:check": "prettier --check src tests scripts .github *.ts *.mjs *.json README.md"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
